Configuration:
  status: WARN
  monitorInterval: 60
  
  appenders:
    Console:
      name: LogToConsole
      PatternLayout:
        Pattern: "%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [@@appName@@,%X{traceId},%X{spanId}] ${sys:PID:- } --- [%15.15t] %-40.40logger{45} : %msg%n"

  Loggers:
    logger:
      - name: com.hon.reds
        level: DEBUG
        additivity: false
        AppenderRef:
          - ref: LogToConsole
          
      - name: @@appPackageName@@
        level: DEBUG
        additivity: false
        AppenderRef:
          - ref: LogToConsole
          
      - name: org.springframework.security
        level: WARN
        additivity: false
        AppenderRef:
          - ref: LogToConsole
       
      - name: org.apache.http
        level: WARN
        additivity: false
        AppenderRef:
          - ref: LogToConsole
          
      - name: org.apache.http.wire
        level: WARN
        additivity: false
        AppenderRef:
          - ref: LogToConsole
          
      - name: com.netflix
        level: INFO
        additivity: false
        AppenderRef:
          - ref: LogToConsole
          
    Root:
      level: INFO
      AppenderRef:
        - ref: LogToConsole
