FROM adoptopenjdk:11.0.6_10-jre-hotspot

MAINTAINER Honeywell

# Creating Work Dirtory /honeywell
RUN mkdir -p /honeywell
RUN mkdir -p /honeywell/wes

# add application jar (the Spring Boot fat JAR) as main.jar
COPY build/libs/@@rootProjectName@@-@@componentVersion@@-exec.jar /honeywell/main.jar

# Add entrypoint.sh at the root of the container
COPY entrypoint.sh /honeywell/entrypoint.sh

# Make sure entrypoint.sh is executable
RUN chmod +x /honeywell/entrypoint.sh

#Createing appuser as NON-ROOT user to run application
RUN groupadd -g 999 appuser && \
        useradd -r -u 999 -g appuser appuser

# Providing access to work directory and tem directory
RUN chown -R appuser:appuser /honeywell
RUN chown appuser:appuser /tmp

USER appuser


# All Spring Boot components expose 8080 as the container port
EXPOSE 8080

# All Spring Boot components expose 8000 as the container java debug port
EXPOSE 8000

# Execute entrypoint.sh as the entrypoint command
ENTRYPOINT ["/honeywell/entrypoint.sh"]

# Start the Spring Boot fat JAR with the given JAVA_OPTS
# JAVA_OPTS takes "$MEM_OPTS $LOG_OPTS $GC_OPTS", default value is set in Entrypoint.sh file and can override at runtime
CMD exec java $JAVA_OPTS -jar /honeywell/main.jar
