# Generated By: CommonFilesPlugin v@@pluginVersion@@
# Generated On: @@generatedTimestamp@@
#

#Default Active-Profile is set to 'docker'
ACTIVE_PROFILES="docker"

# APPLICATION MODE (ex. schedluer, etc.) will restrict the application behaviour to only perform a specific activity and not serve REST calls, etc.
if [ "$APP_MODES" != "" ]
then
    # then assign 'docker' to it by default
    ACTIVE_PROFILES="$ACTIVE_PROFILES,$APP_MODES"
fi

if [ "$DB_TYPE" == "" ]
then
    # then assign 'docker' to it by default
    DB_TYPE="mysql"
fi

if [ "$DB_TYPE" == "mysql" ]
then
    DB_PROFILE="mysql"
    
fi

if [ "$DB_TYPE" == "mssql" ]
then
    DB_PROFILE="mssql"
    
fi

# Setting Spring-Profile with Active-Profile and DB-Profiles
ACTIVE_PROFILES="$ACTIVE_PROFILES,$DB_PROFILE"
export SPRING_PROFILES_ACTIVE="$ACTIVE_PROFILES"



# ################################################ #
# Setup identifying information for this component #
# ################################################ #

# Define APPLICATION_NAME if not already defined
if [ "$APPLICATION_NAME" == "" ]
then
    AN=@@appName@@
    export APPLICATION_NAME=$AN
fi

# Define APPLICATION_INSTANCE_ID if not already defined
if [ "$APPLICATION_INSTANCE_ID" == "" ]
then
    export APPLICATION_INSTANCE_ID="$APPLICATION_NAME-$HOSTNAME"
fi

# Define EUREKA_INSTANCE_METADATAMAP_INSTANCEID if not already defined
if [ "$EUREKA_INSTANCE_METADATAMAP_INSTANCEID" == "" ]
then
    export EUREKA_INSTANCE_METADATAMAP_INSTANCEID="$APPLICATION_INSTANCE_ID"
fi

# ################################################################ #
# Setup externally mounted directories for this component instance #
# ################################################################ #

# Set WORKING_DIR and WORKING_APP_DIR directories
if [ "$WORKING_DIR" == "" ]
then
    export WORKING_DIR="/honeywell/wes/$APPLICATION_NAME"
fi

# create $WORKING_DIR (regardless of whether it exists or not)
mkdir -p $WORKING_DIR
echo "Created WORKING_DIR $WORKING_DIR"

if [ "$WORKING_APP_DIR" == "" ]
then
    export WORKING_APP_DIR="$WORKING_DIR/instances/$HOSTNAME"
fi

# create $WORKING_APP_DIR (regardless of whether it exists or not)
mkdir -p $WORKING_APP_DIR
echo "Created WORKING_APP_DIR $WORKING_APP_DIR"

# create a directory inside WORKING_DIR to store extension jars zip
export EXTENSION_JARS_DIR="$WORKING_DIR/extensionJars"
mkdir -p $EXTENSION_JARS_DIR
echo "Created EXTENSION_JARS_DIR $EXTENSION_JARS_DIR"

#
# create a directory inside WORKING_APP_DIR to store JVM logs and dumps
# that require persistence across container lifecycle
#
export JVM_OUTPUT_DIR="$WORKING_APP_DIR/jvmout"
mkdir -p $JVM_OUTPUT_DIR
mkdir -p $JVM_OUTPUT_DIR/logs
mkdir -p $JVM_OUTPUT_DIR/dumps
echo "Created JVM_OUTPUT_DIR $JVM_OUTPUT_DIR and child directories 'logs' and 'dumps' under it"

# ################################## #
# Set JAVA_OPTS environment variable #
# ################################## #
#if MEM_OPTS is not defined, set the default MEM_OPTS settings
if [ "$MEM_OPTS" == "" ]
then
    export MEM_OPTS="-Xmx@@xmxValue@@ -Xss1024k"
fi

#if EXT_JARS_PATH is not defined, set the default EXT_JARS_PATH settings
if [ "$EXT_JARS_PATH" == "" ]
then
        export EXT_JARS_PATH="-Dloader.path=$EXTENSION_JARS_DIR"
fi

#if JVM_OPTS is not defined, set the default JVM_OPTS
if [ "$JVM_OPTS" == "" ]
then
    export JVM_OPTS="-XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Xlog:gc*=info,safepoint*=info:file=$JVM_OUTPUT_DIR/logs/jvm.log:time,uptime,level,tags:filecount=10,filesize=50M -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=$JVM_OUTPUT_DIR/dumps/oom.hprof -XX:+DisableExplicitGC -XX:+UseStringDeduplication"
fi

export JAVA_OPTS="$MEM_OPTS $EXT_JARS_PATH $JVM_OPTS"

#Log4j2 config
if [ "$LOG_DESTINATION" == "" ]
then
    # By default log to both file and console
    export LOGGING_CONFIG="classpath:log4j2-spring-docker.yml"
elif [ "$LOG_DESTINATION" == "file" ]
then
    # Log to both file
    export LOGGING_CONFIG="classpath:log4j2-spring-docker-file.yml"
else
    # Anything else, log to console
    export LOGGING_CONFIG="classpath:log4j2-spring-docker-console.yml"
fi

if [ "$LOG_OPTS" != "" ]
then
  # Export any system properties to configure log4j2 rolling file appender
  export JAVA_OPTS="$JAVA_OPTS $LOG_OPTS"
fi

# remote debug config
if [ "$REMOTE_DEBUG" == "true" ]
then
    if [ "$DEBUG_SUSPEND" == "true" ]
    then
        export JAVA_OPTS="$JAVA_OPTS -agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=8000"
    else
        export JAVA_OPTS="$JAVA_OPTS -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=8000"
    fi
fi

echo "Exported JAVA_OPTS to $JAVA_OPTS"
echo "Set DB_CLEAN Flag to False"
export DB_CLEAN="false"

# ################################ #
# Output the environment variables #
# ################################ #
echo "---------------------"
echo "ENVIRONMENT VARIABLES"
echo "---------------------"
env
### jasypt properties ###
if [ "$JASYPT_ENCRYPTOR_PASSWORD" == "" ]
then
    # then set the default JASYPT_ENCRYPTOR_PASSWORD settings
    export JASYPT_ENCRYPTOR_PASSWORD="r3dsPl@tf0rmS3cr3t"
fi
if [ "$JASYPT_ENCRYPTOR_ALGORITHM" == "" ]
then
    # then set the default JASYPT_ENCRYPTOR_ALGORITHM settings
    export JASYPT_ENCRYPTOR_ALGORITHM="PBEWithMD5AndDES"
fi
##########################################################
## Defing Component's Upgrade one step process within the container
##########################################################
# Define DB_REQUIRED 
APP_HAS_DB=@@appHasDb@@
if [ "$AUTO_DEPLOY_DB_CHANGES" == "" ]
then
    AUTO_DEPLOY_DB_CHANGES="true"   ## Provides option for overriding Manual-Db-Update
else
    AUTO_DEPLOY_DB_CHANGES="$AUTO_DEPLOY_DB_CHANGES"
fi
# DDL Upgrade , DML Upgrade and Set parameters back to normal for bringing application in API mode
if [ "$APP_HAS_DB" == "true" ] && [ "$AUTO_DEPLOY_DB_CHANGES" == "true" ]
then
    echo "---------------------"
    echo "DDL UPGRADE STARTED"
    echo "---------------------"
    export GENERATE_DDL="true"
    export DDL_EXECUTE="true"
    export UPGRADE_DML="false"
    java $JAVA_OPTS -jar /honeywell/main.jar
    exit_status=`echo $?`
    echo "App exited from DDL upgrade mode. Exit code: $exit_status"
    echo "Please review log for more details"
    if [ "$exit_status" != "0" ]
    then
        echo "Killing container"
        exit 137
    fi

    echo "---------------------"
    echo "DML UPGRADE STARTED"
    echo "---------------------"
    export GENERATE_DDL="false"
    export DDL_EXECUTE="false"
    export UPGRADE_DML="true"
    java $JAVA_OPTS -jar /honeywell/main.jar
    exit_status=`echo $?`
    echo "App exited from DML upgrade mode. Exit code: $exit_status"
    echo "Please review log for more details"
    if [ "$exit_status" != "0" ]
    then
        echo "Killing container"
        exit 137
    fi

    ## Setting Back to Default value
    export GENERATE_DDL="false"
    export DDL_EXECUTE="false"
    export UPGRADE_DML="false"

fi
## DB Upgrade Done ##
echo "Starting app in regular mode"
exec "$@"
