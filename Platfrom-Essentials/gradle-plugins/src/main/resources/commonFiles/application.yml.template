#
# Defines the standard default properties, which can be overridden by
# one of the following ways:
# 1. Create an application-<profile-name>.yml and define one of the properties
#    defined below with overridden value, and then by running the boot app with
#    environment variable SPRING_PROFILES_ACTIVE set as <profile-name>.
#    example: see application-docker.yml
# 2. Send command line argument as shown below with the property name and the
#    overridden value:
#    example: java -jar <app>.jar -server.port=20000
# 3. Set an environment variable as shown below with the property name and the
#    overridden value before starting the app in the same shell:
#    example: export SERVER_PORT=20000 && java -jar <app>.jar
#

#
# Version of this component that will be used to evaluate the update
# requirement. This value is poulated from the version property of
# the gradle project (see build.gradle > version) or the root project
#
component:
  version: @@componentVersion@@
  tag: @@componentVersion@@-@@gitCommitId@@
  git:
    commit: @@gitCommitId@@

server:
  max-http-header-size: 20000
  port: ${unique.app.port}

#
# Eureka configuration
#
eureka:
  instance:
    hostname: ${virtual_host:localhost}
    securePort: ${virtual_port:${unique.app.port}}
    non-secure-port-enabled: ${eureka_instance_non_secure_port_enabled:true}
    secure-port-enabled: ${eureka_instance_secure_port_enabled:false}
    statusPageUrl: http://${virtual_host:localhost}:${virtual_port:${unique.app.port}}/actuator/info
    healthCheckUrl: http://${virtual_host:localhost}:${virtual_port:${unique.app.port}}/actuator/health
    homePageUrl: http://${virtual_host:localhost}:${virtual_port:${unique.app.port}}/
    nonSecurePort: ${virtual_port:${unique.app.port}}
    # It's not required to set eureka.instance.instanceId, as it defaults to CLIENT IP:PORT,
    # but if you do set it, it must be unique within the scope of the appName
    instanceId: ${spring.application.name}-${random.value}
    # An instance registers with a Eureka server using a given URL; then onwards,
    # it sends heartbeats every 30s (or configurable via the following property)
    leaseRenewalIntervalInSeconds: 30
    # If the server doesn't receive a heartbeat, it waits 90s (or configurable via the
    # following property) before removing the instance from registry and there by
    # disallowing traffic to that instance
    leaseExpirationDurationInSeconds: 60
    metadataMap:
      instanceId: ${spring.application.name}-${random.value}
  client:
    # Every instance is represented by an com.netflix.appinfo.InstanceInfo, which is a bunch of
    # information about the instance. The InstanceInfo is sent to the Eureka server at regular
    # intervals, starting at 40s after startup (or configurable via the following property)
    initialInstanceInfoReplicationIntervalSeconds: 15
    # ... and then onwards every 30s (or configurable via the following property)
    instanceInfoReplicationIntervalSeconds: 20
    # If eureka.client.fetchRegistry is true, the client fetches the Eureka server registry
    # at startup and caches it locally
    fetchRegistry: true
    # The registry fetch is an asynchronous task scheduled every 30s (or configurable via the
    # following property)
    registryFetchIntervalSeconds: 10
    serviceUrl:
      # docker is the value mapping to the VM running docker; defined in hosts file
      # if not using docker, define 'xxx.xxx.xxx.xxx  dockerhost' (without quotes) as an entry in hosts file
      # where 'xxx.xxx.xxx.xxx' is the IP address of your host VM (Ubuntu, Boot2Docker or your Mac/Windows)
      defaultZone: http://${eureka_host:dockerhost}:${eureka_port:8761}/eureka/

#
# Ribbon configuration
#
ribbon:
  # Ribbon also maintains a local cache to avoid calling the Eureka client for every request.
  # This cache is refreshed every 30s (or configurable via the following property)
  serverListRefreshInterval: 30

#
# Spring configuration
#
spring:
  # Default Spring datasource configuration.
  datasource:
    platform: mysql
    url: jdbc:mysql://${db.host:dockerhost}:${db.port:${unique.db.port}}/${db.name:${unique.app.shortName}}
    username: ${db.username:${unique.app.shortName}}
    password: ${db.password:${unique.app.shortName}}
    hikari:
      maximum-pool-size: ${db.connection.pool.size:20}
  http:
    multipart:
      max-file-size: 100MB
      max-request-size: 100MB

  # Config for Spring RabbitMQ
  rabbitmq:
    host: ${messaging.host:dockerhost}
    port: ${messaging.port:5672}
    username: ${messaging.userName:guest}
    password: ${messaging.password:guest}

#Actuator end-point Security enabled or disabled
management:
    security:
        enabled: ${scc_management_security_enabled:false}
    #Specifies what Actuator end-points needs to be enabled. Enabling all end-points will have a performance hit,
    #this setting helps to chose the ones we really need.
    endpoints:
        web:
            exposure:
                include: ${actuator_endpoints_exposed:refresh, info, env, health, loggers, metrics, threaddump, heapdump}
