spring:
  application:
    name: ${APPLICATION_NAME:@@appName@@}
  #SCC Server URI
  cloud:
    config:
        uri: http://${scc_host:dockerhost}:${scc_port:8080}
        label: master
  jmx:
    default-domain: ${spring.application.name}
  #Defines the name of the files which needs to be accessable from SCC.
  #These profiles can be accessed from SCC as htt://sccuri/service-name/profile. ex: http://localhost:8080/order/error_codes
  profiles:
    include: ${scc_profiles:error_codes}

# unique attributes of this component
# each of these values must be unique
unique:
  app:
    # short name of this component (e.g., 'order')
    shortName: @@rootProjectName@@
    uniqueId: @@rootProjectUniqueId@@
    # unique HTTP port value where this component listens to by default
    port: @@httpPort@@
  db:
    # unique database port for this component's database
    port: @@dbPort@@
